{
  "name": "@drycov/design-kit",
  "version": "0.3.0",
  "description": "Shared Telegram-style design system for ops platform",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./css": "./css/index.css",
    "./css/tokens": "./css/tokens.css",
    "./css/components": "./css/components.css",
    "./css/layout": "./css/layout.css",
    "./css/utilities": "./css/utilities.css",
    "./css/ops": "./css/ops.css",
    "./package.json": "./package.json"
  },
  "files": ["css", "dist", "src", "README.md", "ADOPTION.md", "COMPONENTS.md", "CHANGELOG.md"],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "typescript": "^5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/drycov/design-kit.git"
  },
  "license": "MIT",
  "keywords": ["design-system", "telegram", "css", "react", "ops-platform"]
}
